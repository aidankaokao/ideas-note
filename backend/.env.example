# 後端「應用層」環境變數範本。複製成 backend/.env（不進版控）。
APP_ENV=dev

# ── 資料庫：初期 sqlite，部署換 Neon PostgreSQL 只改這行 ──
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/appdb

# ── JWT 登入（部署時務必換成長隨機字串）──
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=43200

# LLM provider 不在這裡設定：本專案有前端，使用者在「設定」頁註冊多個 provider（存資料庫）。
